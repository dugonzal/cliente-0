<Project Sdk="Microsoft.NET.Sdk">

  <!-- Las dos referencias apuntan al driver y al simulador, que son privados: van por propiedad
       para que quien los tenga compilados apunte a su copia con
       -p:SnmpDriverProject=/ruta/SnmpDriver.csproj -p:SnmpSimulatorProject=/ruta/SnmpSimulator.csproj -->
  <PropertyGroup>
    <SnmpDriverProject Condition="'$(SnmpDriverProject)' == ''">../../src/SnmpDriver/SnmpDriver.csproj</SnmpDriverProject>
    <SnmpSimulatorProject Condition="'$(SnmpSimulatorProject)' == ''">../../src/SnmpSimulator/SnmpSimulator.csproj</SnmpSimulatorProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(SnmpDriverProject)" />
    <ProjectReference Include="$(SnmpSimulatorProject)" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
